# ==============================================
# SYNC Wellness App - Environment Variables
# ==============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# --- Database (MySQL) ---
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/syncdb
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=syncdb
MYSQL_HOST=localhost
MYSQL_PORT=3306

# --- JWT Authentication ---
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI / Gemini Chatbot API (Backend only - NEVER expose to frontend) ---
# Gemini API key must be configured locally and must never be committed to Git.
GOOGLE_API_KEY=your_gcp_api_key_hereLLM_PROVIDER=gemini

# Active LLM provider options: gemini | mock
# LLM_PROVIDER=mock

# --- Frontend API Connection ---
NEXT_PUBLIC_API_URL=http://localhost:8001

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- App Environment ---
ENVIRONMENT=development
