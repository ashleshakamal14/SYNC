# ==============================================
# SYNC Wellness App - Environment Variables
# ==============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# --- Database ---
DATABASE_URL=postgresql://syncuser:syncpassword@localhost:5432/syncdb
POSTGRES_USER=syncuser
POSTGRES_PASSWORD=syncpassword
POSTGRES_DB=syncdb

# --- JWT Auth ---
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI / LLM API Keys (use at least one) ---
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# Active LLM provider: gemini | openai | groq | mock
LLM_PROVIDER=mock

# --- AWS (optional for local dev) ---
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=sync-wellness-reports

# Use S3 for file storage: true | false
USE_S3=false

# Local storage path (used when USE_S3=false)
LOCAL_STORAGE_PATH=./storage

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Redis (optional) ---
REDIS_URL=redis://localhost:6379

# --- App ---
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
